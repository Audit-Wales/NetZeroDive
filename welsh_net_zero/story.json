  "captions": [
    {
      "srclang": "en",
      "label": "English",
      "default": true,
      "cues": [
        { "startTime": 1200, "endTime": 5800, "text": "Wales is unlikely to achieve the 2030 ambition." },
        { "startTime": 6400, "endTime": 10200, "text": "In 2021, an ambition was set: net zero by 2030." },
        { "startTime": 10400, "endTime": 14600, "text": "In 2022, we found \u2018clear uncertainty\u2019 it would be met." },
        { "startTime": 14800, "endTime": 19000, "text": "Now, it's highly unlikely the public sector will achieve that collective ambition." },
        { "startTime": 21400, "endTime": 25900, "text": "Action has happened \u2014 public bodies have taken steps forward." },
        { "startTime": 26400, "endTime": 33900, "text": "Reporting bodies have increased from 69 to 82 between 2021-22 and 2024-25." },
        { "startTime": 34400, "endTime": 38900, "text": "But decarbonisation has become a lower priority for public bodies." },
        { "startTime": 39400, "endTime": 45900, "text": "Better understanding, more reporting and more plans \u2014 against financial pressures, political pressures, and reticence about delivery." },
        { "startTime": 54400, "endTime": 59200, "text": "Averaged per reporting body, emissions fell sharply after 2021." },
        { "startTime": 59400, "endTime": 64200, "text": "But the last two years show that progress stalling — even ticking back up." },
        { "startTime": 64400, "endTime": 68800, "text": "A sign that decarbonisation is losing momentum as a priority." },
        { "startTime": 69400, "endTime": 73800, "text": "Progress is difficult to measure and deliver." },
        { "startTime": 74400, "endTime": 81800, "text": "Most emissions come from the supply chain \u2014 sitting largely outside public bodies' direct control." },
        { "startTime": 89400, "endTime": 96800, "text": "Finance and skills remain major barriers \u2014 decarbonising council buildings alone is estimated at \u00a32.8 billion, against \u00a3228 million of funding since our last report." },
        { "startTime": 104400, "endTime": 108400, "text": "So what can be done to close the gap?" },
        { "startTime": 109400, "endTime": 116400, "text": "To close the gap, public bodies need clearer direction, better data, financial planning, and stronger skills." }
      ]
    },
    {
      "srclang": "cy",
      "label": "Cymraeg",
      "cues": [
        { "startTime": 1200, "endTime": 5800, "text": "Mae'n annhebygol y bydd Cymru'n cyflawni uchelgais 2030." },
        { "startTime": 6400, "endTime": 10200, "text": "Yn 2021, gosodwyd uchelgais: sero net erbyn 2030." },
        { "startTime": 10400, "endTime": 14600, "text": "Yn 2022, canfuwyd 'ansicrwydd clir' y byddai'n cael ei gyflawni." },
        { "startTime": 14800, "endTime": 19000, "text": "Nawr, mae'n hynod annhebygol y bydd y sector cyhoeddus yn cyflawni'r uchelgais ar y cyd." },
        { "startTime": 21400, "endTime": 25900, "text": "Mae camau wedi'u cymryd \u2014 mae cyrff cyhoeddus wedi cymryd camau ymlaen." },
        { "startTime": 26400, "endTime": 33900, "text": "Mae nifer y cyrff adrodd wedi cynyddu o 69 i 82 rhwng 2021-22 a 2024-25." },
        { "startTime": 34400, "endTime": 38900, "text": "Ond mae datgarboneiddio wedi dod yn flaenoriaeth is i gyrff cyhoeddus." },
        { "startTime": 39400, "endTime": 45900, "text": "Gwell dealltwriaeth, mwy o adrodd a mwy o gynlluniau \u2014 yn erbyn pwysau ariannol, pwysau gwleidyddol, ac amharodrwydd ynghylch cyflawni." },
        { "startTime": 54400, "endTime": 59200, "text": "Ar gyfartaledd fesul corff adrodd, syrthiodd allyriadau'n sydyn ar ôl 2021." },
        { "startTime": 59400, "endTime": 64200, "text": "Ond mae'r ddwy flynedd ddiwethaf yn dangos y cynnydd hwnnw'n arafu — ac yn codi eto hyd yn oed." },
        { "startTime": 64400, "endTime": 68800, "text": "Arwydd bod datgarboneiddio'n colli momentwm fel blaenoriaeth." },
        { "startTime": 69400, "endTime": 73800, "text": "Mae cynnydd yn anodd ei fesur a'i gyflawni." },
        { "startTime": 74400, "endTime": 81800, "text": "Daw'r rhan fwyaf o'r allyriadau o'r gadwyn gyflenwi \u2014 y tu allan i reolaeth uniongyrchol cyrff cyhoeddus, i raddau helaeth." },
        { "startTime": 89400, "endTime": 96800, "text": "Mae cyllid a sgiliau yn parhau i fod yn rhwystrau mawr \u2014 amcangyfrifir cost datgarboneiddio adeiladau cynghorau yn unig yn \u00a32.8 biliwn, o gymharu \u00e2 \u00a3228 miliwn o gyllid ers ein hadroddiad diwethaf." },
        { "startTime": 104400, "endTime": 108400, "text": "Felly beth all gael ei wneud i gau'r bwlch?" },
        { "startTime": 109400, "endTime": 116400, "text": "I gau'r bwlch, mae angen ar gyrff cyhoeddus gyfeiriad cliriach, data gwell, cynllunio ariannol a sgiliau cryfach." }
      ]
    }
  ],
